# KORNNE — STAGING environment TEMPLATE (no secrets). Real file: /srv/kornne-staging/shared/.env.production
# Staging is ALWAYS private and noindex. It must never share a database, media directory, analytics property or
# notification recipient with production.

NODE_ENV=production
PORT=3011
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# CLIENT: staging host, e.g. https://staging.kornne.com (separate DNS record, never the production domain)
SITE_URL=https://staging.example.invalid
SITE_INDEXABLE=false
CATALOG_DATA_VERIFIED=false
SEO_LOCALES=en,tr,de,fr,ru,ar

# Separate database: a Neon BRANCH of the KORNNE project (masked copy) — never the production branch
DATABASE_URL=
DIRECT_URL=
SECRETS_ROTATION_CONFIRMED=false

IP_HASH_SALT=
MEDIA_DIR=/srv/kornne-staging/shared/media/upload

# Second access layer behind Nginx auth_basic (both required on staging)
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# Analytics on staging only with a SEPARATE GA4 property (or off)
ANALYTICS_ENABLED=false
ANALYTICS_GA4_MEASUREMENT_ID=
ANALYTICS_GTM_CONTAINER_ID=
COOKIE_POLICY_APPROVED=false
GOOGLE_SITE_VERIFICATION=

# Notifications: a test mailbox only, never customers
NOTIFY_PROVIDER=
NOTIFY_QUOTE_RECIPIENT=

ENABLE_PAID_CHECKOUT=false
PAYMENT_PROVIDER=
MERCHANT_API_ENABLED=false
MERCHANT_ACCOUNT_ALLOWLIST=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
