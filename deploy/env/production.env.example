# KORNNE — PRODUCTION environment TEMPLATE (no secrets). Real file: /srv/kornne/shared/.env.production
# owner kornne:kornne, chmod 600. Never commit, never print (`cat`), never paste into chat/tickets.
# Every value marked (CLIENT) needs an explicit client decision; leave the safe default until then.

NODE_ENV=production
PORT=3010
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Public origin — used for canonical, hreflang, sitemap, JSON-LD (CLIENT: final domain)
SITE_URL=https://kornne.com
# Indexing switch: "true" ONLY at the approved go-live moment (rollback: set false + restart)
SITE_INDEXABLE=false
# Catalog pages indexable only after price / catalogue / legal approvals (CLIENT)
CATALOG_DATA_VERIFIED=false
SEO_LOCALES=tr

# Database (KORNNE Neon project) — NEW password after the mandatory rotation (P0)
DATABASE_URL=
DIRECT_URL=
SECRETS_ROTATION_CONFIRMED=false

IP_HASH_SALT=
MEDIA_DIR=/srv/kornne/shared/media/upload

# Staging-only gate — must be EMPTY in production
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# Analytics / consent / Search Console (CLIENT accounts; off until approved)
ANALYTICS_ENABLED=false
ANALYTICS_GA4_MEASUREMENT_ID=
ANALYTICS_GTM_CONTAINER_ID=
COOKIE_POLICY_APPROVED=false
GOOGLE_SITE_VERIFICATION=

# Notifications (CLIENT: provider + recipient). Empty = outbox rows stay BLOCKED
NOTIFY_PROVIDER=
NOTIFY_QUOTE_RECIPIENT=

# Commerce — CLOSED (mode A: quote catalogue). Mode B needs every gate in docs/deployment/go-no-go.md
ENABLE_PAID_CHECKOUT=false
PAYMENT_PROVIDER=

# Merchant API — OFF (needs account access, allowlist, rotated secrets)
MERCHANT_API_ENABLED=false
MERCHANT_ACCOUNT_ALLOWLIST=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
