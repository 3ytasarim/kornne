{
  "name": "kornne-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3460",
    "build": "next build",
    "start": "next start -p 3460",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/test-db/e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "media:sync": "node scripts/sync-media-public.mjs",
    "audit:all": "node scripts/audit/parse-crawl.mjs && node scripts/audit/build-locale-mapping.mjs && node scripts/audit/build-redirect-map.mjs",
    "import:legacy": "tsx scripts/import/legacy-import.ts",
    "import:rollback": "tsx scripts/import/rollback.ts",
    "db:identity": "node scripts/db-identity.mjs",
    "db:test:deploy": "node scripts/test-db/deploy.mjs",
    "db:local:start": "node scripts/test-db/local-pg.mjs start",
    "db:local:clone": "node scripts/test-db/local-pg.mjs clone"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.49.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.5",
    "embedded-postgres": "18.3.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
