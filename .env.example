# KORNNE — environment template. Copy to .env (local) or /srv/kornne/shared/.env.production (server).
# Never commit real values. Never log them.

# Public origin used for canonical/hreflang/sitemap/JSON-LD (no trailing slash)
SITE_URL=http://localhost:3460

# Search engines may index this deployment ONLY when exactly "true" (production cutover).
# Local, staging and preview deployments stay noindex (meta robots + X-Robots-Tag + robots.txt Disallow).
SITE_INDEXABLE=false

# Staging Basic Auth (proxy). Leave empty locally; set both on staging.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# KORNNE-only PostgreSQL. Never point this at another project's database.
# Neon (KORNNE project): pooled host for the app, DIRECT_URL = same URL without "-pooler" (migrations).
DATABASE_URL=
# Direct (non-pooled) URL for prisma migrate; falls back to DATABASE_URL
DIRECT_URL=

# Salt for hashing client IPs in rate limiting (random, >= 32 chars)
IP_HASH_SALT=

# Contact data shown on the storefront (verified values only — see docs/audit/open-questions.md)
NEXT_PUBLIC_WHATSAPP_NUMBER=905354068002

# ── Sprint 8 — SEO ──────────────────────────────────────────────────────────────
# Catalog pages (home/category/product) are indexable only when the catalog data is verified (+ SITE_INDEXABLE)
CATALOG_DATA_VERIFIED=false
# Languages whose pages may be indexed / get hreflang (only with approved translations)
SEO_LOCALES=en,tr,de,fr,ru,ar

# ── Sprint 9 — Google Merchant API (products_v1). DISABLED by default — placeholders only ─────────────────────
MERCHANT_API_ENABLED=false
# comma-separated Merchant account ids the adapter may ever write to
MERCHANT_ACCOUNT_ALLOWLIST=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PATH to the service-account JSON/PEM private key file (never paste the key itself here)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# set to true only after the exposed Neon password has been rotated and verified
SECRETS_ROTATION_CONFIRMED=false

# ── Sprint 10 — analytics / consent / Search Console. ALL OFF by default; ids come from the client's own accounts ──
ANALYTICS_ENABLED=false
# GA4 measurement id (G-XXXXXXXXXX) or GTM container id (GTM-XXXXXXX; wins when both are set)
ANALYTICS_GA4_MEASUREMENT_ID=
ANALYTICS_GTM_CONTAINER_ID=
# true only after legal approval of the cookie / KVKK texts (the banner shows "draft" otherwise)
COOKIE_POLICY_APPROVED=false
# Search Console HTML-tag verification token (rendered as <meta name="google-site-verification">), empty = none
GOOGLE_SITE_VERIFICATION=

# ── Sprint 11 — operations ─────────────────────────────────────────────────────────────────────────────────────
# Persistent media directory (release-independent). Default: public/upload inside the release (dev only)
MEDIA_DIR=
# Quote notifications (outbox consumer). Empty = disabled; rows stay BLOCKED and are never shown as sent
NOTIFY_PROVIDER=
NOTIFY_QUOTE_RECIPIENT=
# Paid checkout gate — stays closed (see docs/architecture/commerce-modes.md)
ENABLE_PAID_CHECKOUT=false
